# Year-long 1/60 degree, 100-level MAB run, 2019-04-01 to 2020-04-01 (366 days). Sourced by every script in bin/.
RUN_ROOT=/t0/workdir/enrique/year_run
OUT=$RUN_ROOT/out
SANDBOX=$RUN_ROOT/sandbox     # frozen worktree of the sandbox repo
ENVDIR=$RUN_ROOT/env          # frozen copy of the mpi05_rivers Julia environment
SCRIPT=scripts/05_mab_glorys_tides_reservoirs_distributed.jl
PARTITION=triton16
NRANKS=25
THREADS=16
DT=50
DAY_ITERS=1728                # iterations per simulated day at dt = 50 s
TOTAL_DAYS=366
END_ITER=$((TOTAL_DAYS * DAY_ITERS))
RETAIN=8                      # newest checkpoints kept, plus every 30th simulated day
MONTH_ITERS=$((30 * DAY_ITERS))
START_DATE="2019-04-01 00:00:00"

# Model settings (PRODUCTION_CONFIG.md): 1/60 degree, 100 levels, z*, partial cells, bounded WENO-7 for T and S, rivers
# with the masked surface salinity restoring, cleaned land mask, tides on (default), oblique/reservoir open boundaries
# (defaults), T,S,u,v sponge scaled from the 1/12 degree widths (8 and 4 cells) by 5.
export MAB_START_DATE=2019-04-01 MAB_DAYS=$TOTAL_DAYS
export MAB_CELLS_PER_DEGREE=60 MAB_NZ=100 MAB_DZ_TOP=1 MAB_DT=$DT
export MAB_PARTITION_X=5 MAB_PARTITION_Y=5
export MAB_LAND_FRACTION=0.5 MAB_MASK_CLEANUP=true
export MAB_ZSTAR=true MAB_BOTTOM=partial
export MAB_TRACER_BOUNDS="T:-2:31,S:0:37.2"
export MAB_RIVERS=true MAB_SSS_PISTON=0.5 MAB_SSS_RIVER_MASK=30,100 MAB_SSS_RIVER_QMIN=20
export MAB_SPONGE_VARS=T,S,u,v MAB_SPONGE_WIDTH=40 MAB_N_MATCH=20
export MAB_BAROTROPIC_OUTPUT=true MAB_CATKE_OUTPUT=false MAB_MOORINGS=pioneer
export MAB_CHECKPOINT_EVERY=1 MAB_PROGRESS_MINUTES=60 MAB_SPIKE_THRESHOLD=4
